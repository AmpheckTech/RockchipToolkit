<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>arkt</AssemblyName>
    <RootNamespace>Ampheck.RockchipToolkit</RootNamespace>
    <Company>Ampheck</Company>
    <Product>Ampheck Rockchip Toolkit</Product>
    <Description>Rockchip flashing and ADB command-line toolkit.</Description>
    <Copyright>Copyright (c) 2026 Ampheck</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);ROCKUSB</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);LIBUSB</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="Tomlyn" Version="2.11.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="src/Arkt/Resources/MOTD.txt">
      <LogicalName>Ampheck.RockchipToolkit.MOTD.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64'">
    <Compile Remove="src/HardwareTransport/Backends/RockUsb/**/*.cs" />
  </ItemGroup>
</Project>
